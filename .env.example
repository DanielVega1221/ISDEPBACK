# ============================================
# CONFIGURACIÓN DEL SERVIDOR
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# RESEND API CONFIGURATION
# ============================================
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONFIGURACIÓN DE EMAILS
# ============================================
# Email desde donde se envían las notificaciones
# Nota: Debes verificar tu dominio en Resend para usar un email personalizado
# Mientras tanto, puedes usar: onboarding@resend.dev
EMAIL_FROM=Instituto ISDEP <inscripciones@institutoisdep.com.ar>

# Email donde llegarán las inscripciones
EMAIL_TO=isdep@hotmail.com.ar

# Email para respuestas (Reply-To)
EMAIL_REPLY_TO=isdep@protonmail.com

# ============================================
# CORS - DOMINIOS PERMITIDOS
# ============================================
# Separar múltiples dominios con comas
ALLOWED_ORIGINS=http://localhost:5173,https://www.institutoisdep.com.ar

# ============================================
# CONFIGURACIÓN DE UPLOADS
# ============================================
MAX_FILE_SIZE=5242880
MAX_FILES=5
